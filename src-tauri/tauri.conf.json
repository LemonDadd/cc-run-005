{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KidMath",
  "version": "1.0.0",
  "identifier": "com.kidmath.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KidMath 儿童数学启蒙",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: blob:; audio-src 'self' asset: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 KidMath",
    "category": "Education",
    "shortDescription": "儿童数学启蒙游戏",
    "longDescription": "面向 3-8 岁儿童的纯离线数学启蒙游戏，包含数数、比较、加减法、图形、规律和时钟六种小游戏。"
  }
}
